[Unit]
Description=Check Project TV quiet hours every 15 minutes

[Timer]
# Run once at boot (after the network target has had a chance to settle),
# then on the quarter hour. Persistent=true catches missed runs after a
# suspend or crash the same way sanoid.timer uses it.
OnBootSec=2min
OnCalendar=*:0/15
Persistent=true

[Install]
WantedBy=timers.target
